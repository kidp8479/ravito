# Copy this file to .env and fill in real values. .env is git-ignored -
# never commit real secrets.
#
# Vite only exposes variables prefixed VITE_ to client code, and inlines
# them at build time - never put a real secret here, it ends up in the
# shipped bundle.

# Base URL of the backend API (see backend/.env.example's PORT).
VITE_API_URL=http://localhost:3000
