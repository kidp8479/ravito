# Copy this file to .env and fill in real values.
# .env is git-ignored - never commit real secrets.
#
# Read by docker-compose (`make up`): db credentials, plus whatever the
# backend/frontend services need. See backend/.env.example for the vars
# used by host-side backend tooling (Prisma CLI, tests) instead.

POSTGRES_USER=ravito
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ravito

# Optional - CORS allowed origin for the frontend. Defaults to
# http://localhost:5173 if unset. Override in production.
FRONTEND_ORIGIN=http://localhost:5173

# Symmetric signing key for JWT access tokens (ADR 0002). At least 32
# characters; generate one with `openssl rand -base64 32`.
JWT_ACCESS_SECRET=change_me_to_a_random_32_char_secret
