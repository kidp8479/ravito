{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Otherwise tsc infers the common root from every included file,
    // including prisma.config.ts at the package root, and nests output
    // under dist/src instead of dist - breaking `node dist/main`.
    "rootDir": "src",
    // A different file set than the base config (see `exclude` below) -
    // keep its own incremental cache rather than sharing the base config's.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "prisma.config.ts"]
}
