// Prisma schema: models arrive in RAV-4 (Lot 1). This file only wires the
// datasource + client generator so `prisma generate` / `prisma migrate`
// work from the first commit.
// https://pris.ly/d/prisma-schema

generator client {
  // Classic CJS output (node_modules/.prisma/client) rather than the newer
  // ESM "prisma-client" generator: the latter emits import/export syntax
  // that ts-jest can't load as CommonJS without extra ESM wiring, and this
  // project's tsconfig/eslint are CommonJS throughout.
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HouseholdRole {
  OWNER
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  // Normalized to lowercase at the write boundary (AuthService), so plain
  // case-sensitive uniqueness is enough; see the now-dropped
  // add_case_insensitive_email_index migration.
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  memberships      HouseholdMember[]
  createdInvites   HouseholdInvite[]
  refreshTokens    RefreshToken[]
  addedListItems   ShoppingListItem[] @relation("ShoppingListItemAddedBy")
  checkedListItems ShoppingListItem[] @relation("ShoppingListItemCheckedBy")
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members           HouseholdMember[]
  invites           HouseholdInvite[]
  products          Product[]
  inventoryItems    InventoryItem[]
  shoppingListItems ShoppingListItem[]
  purchaseHistory   PurchaseHistory[]
}

model HouseholdMember {
  householdId String
  userId      String
  role        HouseholdRole
  joinedAt    DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([householdId, userId])
  @@index([userId])
}

model HouseholdInvite {
  id          String    @id @default(cuid())
  householdId String
  code        String    @unique
  expiresAt   DateTime
  createdById String
  consumedAt  DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([createdById])
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  // The token itself is never stored, only its hash, same reasoning as
  // passwords (ADR 0002). A high-entropy random token doesn't need a slow
  // KDF like argon2id, so this is sha256, not argon2.
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  // Points at the token that replaced this one, for reuse-detection chains:
  // a refresh request presenting an already-revoked token revokes the rest
  // of the chain (ADR 0002).
  replacedByTokenId String?   @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Grocery-aisle grouping for the inventory screen (RAV-12). Nullable on
// Product: a quick-added item doesn't have to be categorized up front.
//
// PANTRY started as a single catch-all and, in practice, absorbed most of
// a household's dry goods - spices, canned goods, pasta, condiments, baking
// supplies and snacks all landed in one undifferentiated bucket. Split into
// narrower categories so the inventory screen's grouping is actually useful
// day to day; PANTRY remains as the catch-all for whatever doesn't fit.
enum ProductCategory {
  FRUITS_AND_VEGETABLES
  DAIRY
  MEAT_AND_FISH
  BAKERY
  PASTA_RICE_AND_GRAINS
  CANNED_AND_JARRED
  SAUCES_OILS_AND_CONDIMENTS
  SPICES_AND_HERBS
  BAKING
  SNACKS_AND_DRIED_GOODS
  PANTRY
  FROZEN
  BEVERAGES
  HOUSEHOLD_AND_HYGIENE
  OTHER
}

// The canonical catalogue entry for a product *within one household* - not
// shared across households, so the same "Lait" in two different homes are
// two different rows (future PurchaseHistory / receipt-import anchor).
model Product {
  id          String           @id @default(cuid())
  householdId String
  name        String
  category    ProductCategory?
  defaultUnit String?
  createdAt   DateTime         @default(now())

  household         Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  inventoryItems    InventoryItem[]
  shoppingListItems ShoppingListItem[]
  purchaseHistory   PurchaseHistory[]

  @@unique([householdId, name])
}

// Current pantry stock for one product in one household. One row per
// (household, product): quantity is a running total, not a log of
// individual additions/removals.
model InventoryItem {
  id          String   @id @default(cuid())
  householdId String
  productId   String
  quantity    Float
  unit        String
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([householdId, productId])
  // productId isn't the leading column of the unique index above, so a
  // lookup or cascade delete keyed on it alone wouldn't use it (same
  // reasoning as HouseholdMember.userId, RAV-7).
  @@index([productId])
}

// One row per shopping-list entry. productId is nullable: an item can be
// free text not tied to the household's catalogue ("2 baguettes" typed
// straight in), or linked to a Product for the "add from catalogue" path.
// rawLabel is always set (even when productId is set) so the list still
// displays correctly if the linked product is later renamed or deleted.
model ShoppingListItem {
  id          String   @id @default(cuid())
  householdId String
  productId   String?
  rawLabel    String
  quantity    Float
  unit        String
  checked     Boolean  @default(false)
  // Both nullable with onDelete: SetNull, not Cascade: a shopping list is
  // shared household state that should outlive any one member's account
  // (no account-deletion feature exists yet, but getting this FK behavior
  // right now avoids a painful migration later, PLAN.md's SaaS-ready
  // discipline) - unlike HouseholdInvite.createdById (RAV-4), which
  // cascades because an invite is that user's own artifact, not shared
  // data other members depend on.
  checkedById String?
  addedById   String?
  // Manual ordering for the shopping-list screen's reorder action
  // (PLAN.md); no uniqueness constraint - ties are fine, the frontend
  // just needs *an* order, not a dense/gapless one.
  position    Int
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  checkedBy User?     @relation("ShoppingListItemCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)
  addedBy   User?     @relation("ShoppingListItemAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([productId])
  @@index([checkedById])
  @@index([addedById])
}

// RECEIPT is reserved for the future receipt-import backlog item
// (PLAN.md) - this issue's endpoint only ever writes MANUAL.
enum PurchaseSource {
  MANUAL
  RECEIPT
}

// A purchase event log, not a running total (unlike InventoryItem: one
// row per purchase, not per product). Seeds the future receipt-import
// and price-tracking backlog items.
model PurchaseHistory {
  id          String         @id @default(cuid())
  householdId String
  productId   String?
  // Snapshot of the product's name at purchase time - same reasoning as
  // ShoppingListItem.rawLabel, but matters more here: a price-history log
  // that goes blank whenever its product is renamed or removed from the
  // catalogue defeats the point of keeping the log.
  productName String
  purchasedOn DateTime
  quantity    Float
  unit        String
  unitPrice   Decimal?       @db.Decimal(10, 2)
  source      PurchaseSource @default(MANUAL)
  createdAt   DateTime       @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([productId])
}

model AuditLog {
  id          String   @id @default(cuid())
  householdId String?
  actorUserId String
  action      String
  entity      String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
}
