# Copy this file to .env and fill in real values. .env is git-ignored -
# never commit real secrets.
#
# Used for host-side tooling only (Prisma CLI, tests): the app itself reads
# its config from process env injected by docker-compose or the deploy
# environment (ConfigModule.forRoot has ignoreEnvFile: true - see
# src/app.module.ts). Point DATABASE_URL at the compose `db` service if
# it's reachable from the host, otherwise a local Postgres instance.

NODE_ENV=development
PORT=3000

# Prisma's native connection string format.
DATABASE_URL="postgresql://ravito:change_me@localhost:5432/ravito?schema=public"

# CORS allowed origin for the frontend. Defaults to http://localhost:5173
# if unset.
FRONTEND_ORIGIN=http://localhost:5173

LOG_LEVEL=info
