# Copy to .env.prod on the Droplet and fill in real values.
# .env.prod is git-ignored - never commit it. See docs/deployment.md.
#
# Every value here must be freshly generated for production - never reuse
# a value from the local-dev .env (ADR 0004).

POSTGRES_USER=ravito
POSTGRES_PASSWORD=change_me_generate_with_openssl_rand_base64_32
POSTGRES_DB=ravito

# Symmetric signing key for JWT access tokens (ADR 0002). Generate with:
#   openssl rand -base64 32
JWT_ACCESS_SECRET=change_me_generate_with_openssl_rand_base64_32

# The two subdomains this deployment serves (ADR 0004). Both must already
# point (A record) at this Droplet's IP before first `docker compose up` -
# Caddy's automatic HTTPS needs to complete the ACME challenge on both.
APP_DOMAIN=app.ravi-to.app
API_DOMAIN=api.ravi-to.app
